<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shared container so the widget can read the usage snapshot.
         macOS requires the App Group id to be Team-ID-prefixed; $(DEVELOPMENT_TEAM)
         is expanded at build time to your signing team. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.$(DEVELOPMENT_TEAM).com.hubinsoft.claudeusage</string>
    </array>
    <!--
      Intentionally NOT sandboxed: reading the Claude Code Keychain item created
      by another process is simplest for a non-sandboxed, user-launched agent.
      (No com.apple.security.app-sandbox key = not sandboxed.)
    -->
</dict>
</plist>
